# Enquiry delivery — REQUIRED in production (see src/app/api/enquiry/route.ts).
# Without these the endpoint returns 500 in production rather than silently
# dropping enquiries. This is what closes survey risk R-02.
RESEND_API_KEY=
ENQUIRY_TO=info@saisustainable.com,sales@saisustainable.com

# Set to "false" on staging so the preview can never be indexed and compete
# with production in search.
ALLOW_INDEXING=true
